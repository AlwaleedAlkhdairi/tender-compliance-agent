# Copy this file to .env and fill in your own values.
# Never commit the real .env file.
#
# Configure ONE of the two providers below. If both keys are set, Anthropic
# is used unless LLM_PROVIDER=gemini.

# Option A — Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your-api-key-here
# ANTHROPIC_MODEL=claude-opus-5

# Option B — Google Gemini, free tier available (https://aistudio.google.com/)
# Note: the newest flash models allow only ~20 free requests per model per DAY;
# the fallback model (a lite model with a much larger free quota) takes over
# automatically so a full analysis can always finish at zero cost.
# GEMINI_API_KEY=your-gemini-key-here
# LLM_PROVIDER=gemini
# GEMINI_MODEL=gemini-3.7-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional: maximum tokens per model response (default: 16000)
# MAX_TOKENS=16000

# Optional: where the Chroma vector store is persisted (default: data/chroma)
# CHROMA_DIR=data/chroma

# Optional: where exported comparison files are written (default: outputs)
# OUTPUT_DIR=outputs
