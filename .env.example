# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your-api-key-here

# Optional: Claude model to use (default: claude-opus-5)
ANTHROPIC_MODEL=claude-opus-5

# Optional: where the Chroma vector store is persisted (default: data/chroma)
# CHROMA_DIR=data/chroma

# Optional: where exported comparison files are written (default: outputs)
# OUTPUT_DIR=outputs
